      },
      "case-tunnel-out_1": {
        "x": 791,
        "y": 354
      },
      "str-const_3": {
        "x": 396,
        "y": 349
      },
      "format-into-string_1": {
        "x": 504,
        "y": 298
      },
      "str-const_2": {
        "x": 409,
        "y": 249
      },
      "num-const_1": {
        "x": 475,
        "y": 313
      },
      "str-const_1": {
        "x": 396,
        "y": 349
      }
    },
    "panel": {
      "str-control_1": {
