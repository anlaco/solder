{
  "solder": 1,
  "connector": {
    "pattern": "4-2-2-4",
    "inputs": [
      {
        "name": "str-control_1",
        "cell": 1
      }
    ],
    "outputs": [
      {
        "name": "str-indicator_1",
        "cell": 9
      }
    ]
  },
  "front-panel": [
    {
      "name": "str-control_1",
      "role": "control",
      "type": "string",
      "default": ""
    },
    {
      "name": "str-indicator_1",
      "role": "indicator",
      "type": "string",
      "default": ""
    }
  ],
  "block-diagram": {
    "nodes": [
      {
        "name": "str-control_1",
        "type": "str-control"
      },
      {
        "name": "str-indicator_1",
        "type": "str-indicator"
      }
    ],
    "wires": [
      {
        "from": "str-control_1.result",
        "to": "case-structure_1.selector"
      },
      {
        "from": "case-structure_1.case-tunnel-out_1",
        "to": "str-indicator_1.value"
      }
    ],
    "structures": [
      {
        "name": "case-structure_1",
        "kind": "case-structure",
        "tunnels": [
          {
            "name": "case-tunnel-out_1",
            "dir": "out"
          }
        ],
        "frames": [
          {
            "match": [
              "*IDN?"
            ],
            "body": {
              "nodes": [
                {
                  "name": "str-const_3",
                  "type": "str-const",
                  "config": {
                    "default": "SOLDER,SIM-1,0,0.2"
                  }
                }
              ],
              "wires": [
                {
                  "from": "str-const_3.result",
                  "to": "case-structure_1.case-tunnel-out_1"
                }
              ]
            }
          },
          {
            "match": [
              "MEAS:VOLT?"
            ],
            "body": {
              "nodes": [
                {
                  "name": "format-into-string_1",
                  "type": "format-into-string",
                  "config": {
                    "inputs": 1
                  }
                },
                {
                  "name": "str-const_2",
                  "type": "str-const",
                  "config": {
                    "default": "%.4f"
                  }
                },
                {
                  "name": "num-const_1",
                  "type": "num-const",
                  "config": {
                    "type": "number",
                    "default": 5
                  }
                }
              ],
              "wires": [
                {
                  "from": "str-const_2.result",
                  "to": "format-into-string_1.format-string"
                },
                {
                  "from": "num-const_1.result",
                  "to": "format-into-string_1.input-0"
                },
                {
                  "from": "format-into-string_1.resulting-string",
                  "to": "case-structure_1.case-tunnel-out_1"
                }
              ]
            }
          },
          {
            "default": true,
            "body": {
              "nodes": [
                {
                  "name": "str-const_1",
                  "type": "str-const",
                  "config": {
                    "default": "ERR unknown command"
                  }
                }
              ],
              "wires": [
                {
                  "from": "str-const_1.result",
                  "to": "case-structure_1.case-tunnel-out_1"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "layout": {
    "diagram": {
      "str-control_1": {
        "x": 100,
        "y": 91,
        "label": {
          "text": "Command"
        }
      },
      "str-indicator_1": {
        "x": 350,
        "y": 91,
        "label": {
          "text": "Reply"
        }
      },
      "case-structure_1": {
        "x": 250,
