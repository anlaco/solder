{
  "solder": 1,
  "connector": {
    "pattern": "4-2-2-4",
    "inputs": [
      {
        "name": "str-control_1",
        "cell": 0
      },
      {
        "name": "cluster-control_1",
        "cell": 3
      }
    ],
    "outputs": [
