      {
        "name": "cluster-indicator_1",
        "cell": 11
      }
    ]
  },
  "front-panel": [
    {
      "name": "str-control_1",
      "role": "control",
      "type": "string",
      "default": ""
    },
    {
      "name": "indicator_1",
      "role": "indicator",
      "type": "number",
      "default": 0
    },
    {
      "name": "cluster-control_1",
      "role": "control",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "style": "error-in"
    },
    {
      "name": "cluster-indicator_1",
      "role": "indicator",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "style": "error-out"
    }
  ],
  "block-diagram": {
    "nodes": [
      {
        "name": "str-control_1",
        "type": "str-control"
      },
      {
        "name": "indicator_1",
        "type": "indicator"
      },
      {
        "name": "scan-from-string_1",
        "type": "scan-from-string",
        "config": {
          "inputs": 1
        }
      },
      {
        "name": "str-const_1",
        "type": "str-const",
        "config": {
          "default": "%f"
        }
      },
      {
        "name": "cluster-control_1",
        "type": "cluster-control"
      },
      {
        "name": "cluster-indicator_1",
        "type": "cluster-indicator"
      }
    ],
    "wires": [
      {
        "from": "str-control_1.result",
        "to": "scan-from-string_1.input-string"
      },
      {
        "from": "scan-from-string_1.output-0",
        "to": "indicator_1.value"
      },
      {
        "from": "str-const_1.result",
        "to": "scan-from-string_1.format-string"
      },
      {
        "from": "cluster-control_1.result",
        "to": "scan-from-string_1.error-in"
      },
      {
        "from": "scan-from-string_1.error-out",
        "to": "cluster-indicator_1.value"
      }
    ]
  },
  "layout": {
    "diagram": {
      "str-control_1": {
