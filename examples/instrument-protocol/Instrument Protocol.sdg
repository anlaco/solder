{
  "solder": 1,
  "front-panel": [
    {
      "name": "str-control_1",
      "role": "control",
      "type": "string",
      "default": "MEAS:VOLT?"
    },
    {
      "name": "str-indicator_1",
      "role": "indicator",
      "type": "string",
      "default": ""
    },
    {
      "name": "bool-control_1",
      "role": "control",
      "type": "boolean",
      "default": false,
      "style": "stop-button",
      "mechanical-action": "latch-when-released"
    },
    {
      "name": "waveform-chart_1",
      "role": "indicator",
      "type": "number"
    },
    {
      "name": "cluster-indicator_1",
      "role": "indicator",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "style": "error-out"
    }
  ],
  "block-diagram": {
    "nodes": [
      {
        "name": "str-indicator_1",
        "type": "str-indicator"
      },
      {
        "name": "subvi_2",
        "type": "subvi",
        "config": {
          "vi": "Simulated Instrument.sdg"
        }
      },
      {
        "name": "str-const_1",
        "type": "str-const",
        "config": {
          "default": "*IDN?"
        }
      },
      {
        "name": "simple-error-handler_1",
        "type": "simple-error-handler"
      },
      {
        "name": "cluster-indicator_1",
        "type": "cluster-indicator"
      }
    ],
    "wires": [
      {
        "from": "str-const_1.result",
        "to": "subvi_2.str-control_1"
      },
      {
        "from": "while-loop_1.shift-register-left_1",
        "to": "simple-error-handler_1.error-in"
      },
      {
        "from": "simple-error-handler_1.error-out",
        "to": "cluster-indicator_1.value"
      },
      {
        "from": "subvi_2.str-indicator_1",
        "to": "str-indicator_1.value"
      }
    ],
    "structures": [
      {
        "name": "while-loop_1",
        "kind": "while-loop",
        "shift-registers": [
          {
            "name": "shift-register-left_1"
          }
        ],
        "body": {
          "nodes": [
            {
              "name": "str-control_1",
              "type": "str-control"
            },
            {
              "name": "bool-control_1",
              "type": "bool-control"
            },
            {
              "name": "waveform-chart_1",
              "type": "waveform-chart"
            },
            {
              "name": "subvi_1",
              "type": "subvi",
              "config": {
                "vi": "Simulated Instrument.sdg"
              }
            },
            {
              "name": "subvi_3",
              "type": "subvi",
              "config": {
                "vi": "Parse Reply.sdg"
              }
            },
            {
              "name": "unbundle-by-name_1",
              "type": "unbundle-by-name",
              "config": {
                "items": [
                  "status"
                ]
              }
            },
            {
              "name": "or-op_1",
              "type": "or-op"
            },
            {
              "name": "wait-ms_1",
              "type": "wait-ms"
            },
            {
              "name": "num-const_1",
              "type": "num-const",
              "config": {
                "type": "u32",
                "default": 100
              }
            }
          ],
          "wires": [
            {
              "from": "str-control_1.result",
              "to": "subvi_1.str-control_1"
            },
            {
              "from": "subvi_1.str-indicator_1",
              "to": "subvi_3.str-control_1"
            },
            {
              "from": "subvi_3.indicator_1",
              "to": "waveform-chart_1.value"
            },
            {
              "from": "subvi_3.cluster-indicator_1",
              "to": "shift-register-left_1.right"
            },
            {
              "from": "shift-register-left_1.left",
              "to": "subvi_3.cluster-control_1"
            },
            {
              "from": "subvi_3.cluster-indicator_1",
              "to": "unbundle-by-name_1.cluster"
            },
            {
              "from": "unbundle-by-name_1.element-0",
              "to": "or-op_1.x"
            },
            {
              "from": "bool-control_1.result",
              "to": "or-op_1.y"
            },
            {
              "from": "or-op_1.result",
              "to": "while-loop_1.condition"
            },
            {
              "from": "num-const_1.result",
              "to": "wait-ms_1.ms"
            }
          ]
        }
      }
    ]
  },
