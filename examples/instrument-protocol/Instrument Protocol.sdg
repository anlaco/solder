    {
      "name": "waveform-chart_1",
      "role": "indicator",
      "type": "number"
    },
    {
      "name": "bool-control_1",
      "role": "control",
      "type": "boolean",
      "default": false,
      "style": "stop-button",
      "mechanical-action": "latch-when-released"
    },
    {
      "name": "cluster-indicator_1",
      "role": "indicator",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "default": {
        "status": false,
        "code": 0,
        "source": ""
      },
      "style": "error-out"
    }
  ],
