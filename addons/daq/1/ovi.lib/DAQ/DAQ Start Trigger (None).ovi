        "frames": [
          {
            "match": [
              {
                "noError": true
              }
            ],
            "body": {
              "nodes": [
                {
                  "name": "call-library_1",
                  "type": "call-library",
                  "config": {
                    "library": "nilvaiu.*",
                    "specify-path-on-diagram": false,
                    "function": "DAQDisableStartTrig",
                    "thread": "any",
                    "calling-convention": "c",
                    "error-checking": "default",
                    "return-type": {
                      "type": "numeric",
                      "data-type": "i32"
                    },
                    "parameters": [
                      {
                        "name": "taskID",
                        "type": "numeric",
                        "data-type": "uptr",
                        "pass": "value"
                      },
                      {
                        "name": "extendedErrorIndo",
                        "type": "string",
                        "string-format": "string-handle"
                      }
                    ]
                  }
                },
                {
