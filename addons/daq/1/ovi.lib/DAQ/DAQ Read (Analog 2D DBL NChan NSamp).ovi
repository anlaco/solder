          "specify-path-on-diagram": false,
          "function": "DAQReadNChanNSamp2DF64",
          "thread": "any",
          "calling-convention": "c",
          "error-checking": "default",
          "return-type": {
            "type": "numeric",
            "data-type": "i32"
          },
          "parameters": [
            {
              "name": "taskID",
