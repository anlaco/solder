      },
      {
        "name": "call-library_1",
        "type": "call-library",
        "config": {
          "library": "nilvaiu.*",
          "specify-path-on-diagram": false,
          "function": "DAQCfgSampClkTiming",
          "thread": "any",
          "calling-convention": "c",
          "error-checking": "default",
          "return-type": {
            "type": "numeric",
            "data-type": "i32"
          },
          "parameters": [
            {
              "name": "taskID",
              "type": "numeric",
              "data-type": "uptr",
              "pass": "value"
            },
            {
              "name": "source",
              "type": "string",
              "string-format": "string-handle",
              "constant": true
            },
            {
              "name": "rate",
              "type": "numeric",
              "data-type": "dbl",
              "pass": "value",
              "constant": true
            },
            {
              "name": "activeEdge",
              "type": "numeric",
              "data-type": "i32",
              "pass": "value",
              "constant": true
            },
            {
              "name": "sampleMode",
              "type": "numeric",
              "data-type": "i32",
              "pass": "value",
              "constant": true
            },
            {
              "name": "samplesPerChannel",
              "type": "numeric",
              "data-type": "u64",
              "pass": "value",
              "constant": true
            },
            {
              "name": "extendedErrorInfo",
              "type": "string",
              "string-format": "string-handle"
            }
          ]
        }
      },
      {
        "name": "empty-string-constant_1",
        "type": "empty-string-constant"
      },
      {
        "name": "subvi_1",
        "type": "subvi",
        "config": {
          "vi": "DAQ Fill In Error Info.sdg"
        }
      },
      {
        "name": "control_1",
        "type": "control"
      },
      {
        "name": "control_2",
        "type": "control"
      },
      {
        "name": "control_3",
        "type": "control"
      },
      {
        "name": "control_4",
        "type": "control"
      },
      {
        "name": "daq-name-control_2",
        "type": "daq-name-control"
      }
    ],
    "wires": [
      {
        "from": "empty-string-constant_1.result",
        "to": "call-library_1.arg-6-in"
      },
      {
        "from": "call-library_1.return",
