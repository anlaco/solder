        "config": {
          "type": "u32",
          "default": 0
        }
      },
      {
        "name": "arr-control_1",
        "type": "arr-control"
      }
    ],
    "wires": [
      {
        "from": "call-library_1.return",
        "to": "subvi_1.control_2"
      },
      {
