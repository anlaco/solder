      },
      {
        "name": "call-library_1",
        "type": "call-library",
        "config": {
          "library": "nilvaiu.*",
          "specify-path-on-diagram": false,
          "function": "DAQWriteNChanNSamp2DF64",
          "thread": "any",
          "calling-convention": "c",
          "error-checking": "default",
          "return-type": {
            "type": "numeric",
            "data-type": "i32"
          },
          "parameters": [
            {
              "name": "taskID",
              "type": "numeric",
              "data-type": "uptr",
              "pass": "value"
            },
            {
              "name": "timeout",
              "type": "numeric",
              "data-type": "dbl",
              "pass": "value",
              "constant": false
            },
            {
              "name": "autoStart",
              "type": "numeric",
              "data-type": "u8",
              "pass": "value"
            },
            {
              "name": "data",
              "type": "array",
              "data-type": "dbl",
              "dimensions": 2,
              "array-format": "array-handle"
            },
            {
              "name": "numSamplesWriten",
              "type": "numeric",
              "data-type": "u32",
              "pass": "pointer"
            },
            {
              "name": "extendedErrorInfo",
              "type": "string",
              "string-format": "string-handle"
            }
          ]
        }
      },
      {
        "name": "empty-string-constant_1",
        "type": "empty-string-constant"
      },
      {
        "name": "subvi_1",
        "type": "subvi",
        "config": {
          "vi": "DAQ Fill In Error Info.sdg"
        }
      },
      {
        "name": "control_1",
        "type": "control"
      },
      {
        "name": "bool-control_1",
        "type": "bool-control"
      },
      {
        "name": "indicator_1",
        "type": "indicator"
      },
      {
        "name": "boolean-to-0-1_1",
        "type": "boolean-to-0-1"
      },
      {
        "name": "num-const_1",
