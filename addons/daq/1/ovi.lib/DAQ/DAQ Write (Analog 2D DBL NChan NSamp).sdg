      "role": "control",
      "type": "number",
      "default": 10
    },
    {
      "name": "bool-control_1",
      "role": "control",
      "type": "boolean",
      "default": false,
      "style": "horizontal-toggle-switch",
      "mechanical-action": "switch-when-pressed"
    },
    {
      "name": "indicator_1",
      "role": "indicator",
      "type": "u32",
      "default": 0
    },
    {
      "name": "arr-control_1",
      "role": "control",
      "type": {
        "array": "number",
        "dims": 2
      },
      "default": [],
      "visible-elements": [
        1,
        1
      ],
      "index": [
        0,
        0
      ]
    }
  ],
  "block-diagram": {
    "nodes": [
      {
        "name": "cluster-control_1",
        "type": "cluster-control"
      },
      {
        "name": "cluster-indicator_1",
        "type": "cluster-indicator"
      },
      {
