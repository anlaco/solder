{
  "solder": 5,
  "connector": {
    "pattern": 4833,
    "inputs": [
      {
        "name": "daq-name-control_1",
        "cell": 0,
        "connection": "required"
      },
      {
        "name": "cluster-control_1",
        "cell": 11
      }
    ],
    "outputs": [
      {
        "name": "daq-name-indicator_1",
        "cell": 4
      },
      {
        "name": "cluster-indicator_1",
        "cell": 15
      }
    ]
  },
  "front-panel": [
    {
      "name": "cluster-control_1",
      "role": "control",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "default": {
        "status": false,
        "code": 0,
        "source": ""
      },
      "style": "error-in"
    },
    {
      "name": "cluster-indicator_1",
      "role": "indicator",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "default": {
        "status": false,
        "code": 0,
        "source": ""
      },
      "style": "error-out"
    },
    {
      "name": "daq-name-control_1",
      "role": "control",
      "type": {
        "daq-name": "task"
      },
      "default": ""
    },
    {
      "name": "daq-name-indicator_1",
      "role": "indicator",
      "type": {
        "daq-name": "task"
      },
      "default": ""
    }
  ],
  "block-diagram": {
    "nodes": [
      {
        "name": "cluster-control_1",
        "type": "cluster-control"
      },
      {
        "name": "cluster-indicator_1",
        "type": "cluster-indicator"
      },
      {
        "name": "daq-name-control_1",
        "type": "daq-name-control"
      },
      {
        "name": "daq-name-indicator_1",
        "type": "daq-name-indicator"
      },
      {
        "name": "call-library_1",
        "type": "call-library",
        "config": {
          "library": "nilvaiu.*",
          "specify-path-on-diagram": false,
          "function": "DAQControl",
          "thread": "any",
          "calling-convention": "c",
          "error-checking": "default",
          "return-type": {
            "type": "numeric",
            "data-type": "i32"
          },
          "parameters": [
            {
              "name": "taskID",
              "type": "numeric",
              "data-type": "uptr",
              "pass": "value"
            },
            {
              "name": "mode",
              "type": "numeric",
              "data-type": "u32",
              "pass": "value"
            },
            {
              "name": "extendedErrorInfo",
              "type": "string",
              "string-format": "string-handle"
            }
          ]
        }
      },
      {
        "name": "num-const_1",
        "type": "num-const",
        "config": {
          "type": "i32",
          "default": 1
        }
      },
      {
        "name": "empty-string-constant_1",
        "type": "empty-string-constant"
      },
      {
        "name": "subvi_1",
        "type": "subvi",
        "config": {
          "vi": "DAQ Fill In Error Info.ovi"
        }
      }
    ],
    "wires": [
      {
        "from": "num-const_1.result",
        "to": "call-library_1.arg-1-in"
      },
      {
        "from": "empty-string-constant_1.result",
        "to": "call-library_1.arg-2-in"
      },
      {
        "from": "call-library_1.return",
        "to": "subvi_1.control_2"
      },
      {
        "from": "call-library_1.arg-2-out",
        "to": "subvi_1.str-control_1"
      },
      {
        "from": "daq-name-control_1.result",
        "to": "call-library_1.arg-0-in"
      },
      {
        "from": "subvi_1.cluster-indicator_1",
        "to": "cluster-indicator_1.value"
      },
      {
        "from": "daq-name-control_1.result",
        "to": "daq-name-indicator_1.value"
      },
      {
        "from": "cluster-control_1.result",
        "to": "subvi_1.cluster-control_1"
      }
    ]
  },
