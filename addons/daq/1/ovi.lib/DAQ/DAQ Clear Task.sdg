{
  "solder": 5,
  "connector": {
    "pattern": 4833,
    "inputs": [
      {
        "name": "daq-name-control_1",
        "cell": 0,
        "connection": "required"
      },
      {
        "name": "cluster-control_1",
        "cell": 11
      }
    ],
    "outputs": [
      {
        "name": "cluster-indicator_1",
        "cell": 15
      }
    ]
  },
  "front-panel": [
    {
      "name": "cluster-control_1",
      "role": "control",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "default": {
        "status": false,
        "code": 0,
        "source": ""
      },
      "style": "error-in"
    },
    {
      "name": "cluster-indicator_1",
      "role": "indicator",
      "type": {
        "cluster": [
          {
            "name": "status",
            "type": "boolean"
          },
          {
            "name": "code",
            "type": "i32"
          },
          {
            "name": "source",
            "type": "string"
          }
        ]
      },
      "default": {
        "status": false,
        "code": 0,
        "source": ""
      },
      "style": "error-out"
    },
    {
      "name": "daq-name-control_1",
      "role": "control",
      "type": {
        "daq-name": "task"
      },
      "default": ""
    }
  ],
  "block-diagram": {
    "nodes": [
      {
        "name": "cluster-control_1",
        "type": "cluster-control"
      },
      {
        "name": "cluster-indicator_1",
        "type": "cluster-indicator"
      },
      {
        "name": "daq-name-control_1",
        "type": "daq-name-control"
      },
      {
        "name": "call-library_1",
        "type": "call-library",
        "config": {
          "library": "nilvaiu.*",
          "specify-path-on-diagram": false,
          "function": "DAQDestroyTask110",
          "thread": "any",
          "calling-convention": "c",
          "error-checking": "default",
          "return-type": {
            "type": "numeric",
            "data-type": "i32"
          },
          "parameters": [
            {
              "name": "taskRefObjPtr",
              "type": "adapt-to-type",
              "data-format": "handles-by-value"
            },
            {
              "name": "errorInfo",
              "type": "string",
              "string-format": "string-handle"
            }
          ]
        }
      },
      {
        "name": "empty-string-constant_1",
        "type": "empty-string-constant"
      },
      {
        "name": "subvi_1",
        "type": "subvi",
        "config": {
          "vi": "DAQ Fill In Error Info.sdg"
        }
      }
    ],
    "wires": [
      {
        "from": "daq-name-control_1.result",
        "to": "call-library_1.arg-0-in"
      },
      {
        "from": "cluster-control_1.result",
        "to": "call-library_1.error-in"
      },
      {
        "from": "empty-string-constant_1.result",
        "to": "call-library_1.arg-1-in"
      },
      {
        "from": "call-library_1.return",
        "to": "subvi_1.control_2"
      },
      {
        "from": "call-library_1.arg-1-out",
        "to": "subvi_1.str-control_1"
      },
      {
        "from": "call-library_1.error-out",
        "to": "subvi_1.cluster-control_1"
      },
      {
        "from": "subvi_1.cluster-indicator_1",
        "to": "cluster-indicator_1.value"
      }
    ]
  },
  "layout": {
    "diagram": {
