{
  "name": "@solder/editor",
  "productName": "Solder",
  "version": "0.15.3-beta",
  "private": true,
  "type": "module",
  "description": "Solder: a free visual programming language that clones LabVIEW.",
  "author": "anlaco",
  "homepage": "https://github.com/anlaco/solder",
  "license": "AGPL-3.0-only",
  "main": "editor/electron/main.mjs",
  "scripts": {
    "app": "node scripts/start-editor.mjs",
    "test": "node scripts/run-tests.mjs",
    "dist": "node scripts/build-native.mjs --release --for-release && node scripts/pack-addons.mjs --for-release && electron-builder --linux AppImage deb --win nsis --publish never"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "ajv": "^8.17.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "dev.anlaco.solder",
    "productName": "Solder",
    "artifactName": "Solder-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "anlaco",
        "repo": "solder",
        "releaseType": "prerelease"
      }
    ],
    "files": [
      "package.json",
      "editor/**/*",
      "core/**/*",
      "docs/schema/blocks.json",
      "docs/schema/properties.json",
      "docs/schema/inventario-labview.json",
      "build/icon.png",
      "native/solder-io-node/solder-io.mjs"
    ],
    "extraResources": [
      {
        "from": "ovi.lib",
        "to": "ovi.lib"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "anlaco",
      "synopsis": "A free visual programming language that clones LabVIEW",
      "executableName": "solder",
      "syncDesktopName": true,
      "files": [
        "native/solder-io-node/solder-io-linux-x64.node",
        "native/solder-io-node/memory-bridge/linux-x64/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Solder",
      "files": [
        "native/solder-io-node/solder-io-win32-x64.node",
        "native/solder-io-node/memory-bridge/win32-x64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Solder",
      "include": "build/installer.nsh"
    },
    "executableName": "solder",
    "icon": "build/icon.png",
    "fileAssociations": [
      {
        "ext": "ovi",
        "name": "Solder OVI",
        "description": "Solder OVI",
        "icon": "build/icon",
        "role": "Editor"
      },
      {
        "ext": "sdg",
        "name": "Solder OVI (old extension)",
        "description": "Solder OVI (old extension)",
        "icon": "build/icon",
        "role": "Editor"
      },
      {
        "ext": "qvi",
        "name": "Solder OVI (first extension)",
        "description": "Solder OVI (first extension)",
        "icon": "build/icon",
        "role": "Editor"
      }
    ],
    "asarUnpack": [
      "native/**/*.node",
      "native/solder-io-node/memory-bridge/**"
    ]
  },
  "desktopName": "solder.desktop",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
