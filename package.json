{
  "name": "@solder/editor",
  "productName": "Solder",
  "version": "0.6.0-beta",
  "private": true,
  "type": "module",
  "description": "Solder: a free visual programming language that clones LabVIEW.",
  "author": "anlaco",
  "homepage": "https://github.com/anlaco/solder",
  "license": "AGPL-3.0-only",
  "main": "editor/electron/main.mjs",
  "scripts": {
    "app": "node scripts/start-editor.mjs",
    "test": "node scripts/run-tests.mjs",
    "dist": "electron-builder --linux AppImage deb --win nsis --publish never"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.8.15",
    "ajv": "^8.17.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.anlaco.solder",
    "productName": "Solder",
    "artifactName": "Solder-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "editor/**/*",
      "core/**/*",
      "docs/schema/blocks.json",
      "docs/schema/inventario-labview.json",
      "build/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "anlaco",
      "synopsis": "A free visual programming language that clones LabVIEW",
      "executableName": "solder",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Solder"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Solder",
      "include": "build/installer.nsh"
    },
    "executableName": "solder",
    "icon": "build/icon.png",
    "fileAssociations": [
      {
        "ext": "sdg",
        "name": "Solder VI",
        "description": "Solder VI",
        "icon": "build/icon",
        "role": "Editor"
      },
      {
        "ext": "qvi",
        "name": "Solder VI (old extension)",
        "description": "Solder VI (old extension)",
        "icon": "build/icon",
        "role": "Editor"
      }
    ]
  },
  "desktopName": "solder.desktop"
}
